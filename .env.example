# ============================================================
# FinanceIQ – Configuração (Node/Express + PostgreSQL)
# Copie para .env e ajuste os valores
# ============================================================

# Session secret - troque por um valor aleatório
SESSION_SECRET=your-random-secret-here-change-me

# Conexão PostgreSQL (Vercel Postgres / Neon / Supabase)
# Vercel Postgres já injeta POSTGRES_URL automaticamente ao vincular o projeto.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Server port (Hostinger/VPS usa process.env.PORT internamente)
PORT=3000

# Pool de conexões (opcional)
# PG_POOL_MAX=5
